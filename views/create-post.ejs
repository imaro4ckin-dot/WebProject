<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Budget Escapes | <%= typeof post !== 'undefined' ? 'Edit Post' : 'New Post' %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Space+Grotesk:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <!-- Quill rich text editor (theming for this lives in style.css, section 10c) -->
    <link href="https://cdn.quilljs.com/1.3.7/quill.snow.css" rel="stylesheet">
</head>
<body style="display:flex; flex-direction:column; min-height:100vh; margin:0;">

<%- include('partials/header', { page: '' }) %>

<main id="main-content" role="main" class="container" style="max-width:720px; padding-top: var(--space-6); padding-bottom: var(--space-8);">

    <h1 style="font-size:28px; margin-bottom: var(--space-6);">
        <%= typeof post !== 'undefined' ? 'Edit post' : 'Create a new post' %>
    </h1>

    <form id="postForm" enctype="multipart/form-data" class="form-card">

        <!-- Title -->
        <div class="field">
            <label for="title">Title <span style="color:var(--danger);">*</span></label>
            <input type="text" id="title" name="title" required
                value="<%= typeof post !== 'undefined' ? post.title : '' %>"
                placeholder="e.g. A Weekend in Lisbon on €50">
        </div>

        <!-- Category -->
        <div class="field">
            <label for="category">Category <span style="color:var(--danger);">*</span></label>
            <select id="category" name="category" required>
                <option value="" disabled <%= typeof post === 'undefined' ? 'selected' : '' %>>Select a category...</option>
                <% ['Nature','City','Culture','Food','Adventure'].forEach(function(cat) { %>
                    <option value="<%= cat %>" <%= typeof post !== 'undefined' && post.category === cat ? 'selected' : '' %>><%= cat %></option>
                <% }) %>
            </select>
        </div>

        <!-- Tags -->
        <div class="field">
            <label for="tags">Tags <span style="color:var(--text-muted); font-weight:400; text-transform:none;">(optional, comma-separated)</span></label>
            <input type="text" id="tags" name="tags"
                value="<%= typeof post !== 'undefined' && post.tags ? post.tags : '' %>"
                placeholder="e.g. budget, europe, hiking">
        </div>

        <!-- Featured image -->
        <div class="field">
            <label for="image">Featured image <span style="color:var(--text-muted); font-weight:400; text-transform:none;">(optional)</span></label>
            <% if (typeof post !== 'undefined' && post.image) { %>
                <div class="current-image-preview">
                    <img src="<%= imgUrl(post.image) %>" alt="Current featured image for <%= post.title %>">
                    <p>Upload a new image to replace this one.</p>
                </div>
            <% } %>
            <input type="file" id="image" name="image" accept="image/*">
        </div>

        <!-- Content — Quill editor -->
        <div class="field">
            <label id="contentLabel">Content <span style="color:var(--danger);">*</span></label>
            <div id="quillEditor" aria-labelledby="contentLabel" role="textbox" aria-multiline="true"></div>
            <!-- Hidden input that holds the HTML for form submission -->
            <input type="hidden" id="content" name="content">
        </div>

        <p id="formError" class="alert alert-error hidden" role="alert"></p>
        <p id="formSuccess" class="alert alert-success hidden" role="status"></p>

        <div class="form-actions">
            <button type="submit" class="btn btn-lg">
                <%= typeof post !== 'undefined' ? 'Save changes' : 'Publish post' %>
            </button>
            <a href="/destinations" class="btn btn-outline btn-lg">Cancel</a>
        </div>

    </form>
</main>

<%- include('partials/footer') %>

<script src="https://cdn.quilljs.com/1.3.7/quill.min.js"></script>
<script>
    // --- Quill setup ---
    const quill = new Quill('#quillEditor', {
        theme: 'snow',
        placeholder: 'Write your travel post here...',
        modules: {
            toolbar: [
                [{ header: [2, 3, false] }],
                ['bold', 'italic', 'underline'],
                [{ list: 'ordered' }, { list: 'bullet' }],
                ['blockquote', 'link'],
                ['clean']
            ]
        }
    });

    // Pre-fill editor when editing an existing post
    <% if (typeof post !== 'undefined' && post.content) { %>
        quill.root.innerHTML = <%- JSON.stringify(post.content) %>;
    <% } %>

    // --- Form submission ---
    const form       = document.getElementById('postForm');
    const errorEl    = document.getElementById('formError');
    const successEl  = document.getElementById('formSuccess');

    <% const isEdit = typeof post !== 'undefined'; %>
    const isEdit = <%= isEdit %>;
    const postSlug = isEdit ? '<%= typeof post !== "undefined" && post.slug ? post.slug : "" %>' : null;

    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        errorEl.classList.add('hidden');
        successEl.classList.add('hidden');

        // Copy Quill HTML into the hidden input before submitting
        const html = quill.root.innerHTML;
        if (html === '<p><br></p>' || html.trim() === '') {
            errorEl.textContent = 'Content cannot be empty.';
            errorEl.classList.remove('hidden');
            return;
        }
        document.getElementById('content').value = html;

        const formData = new FormData(form);
        const url    = isEdit ? `/api/posts/<%= typeof post !== 'undefined' && post.id ? post.id : '' %>` : '/api/posts';
        const method = isEdit ? 'PUT' : 'POST';

        let res, data;
        try {
            res  = await fetch(url, { method, body: formData });
            data = await res.json();
        } catch (err) {
            errorEl.textContent = 'Network error. Please try again.';
            errorEl.classList.remove('hidden');
            return;
        }

        if (res.ok) {
            successEl.textContent = isEdit ? 'Post updated!' : 'Post published!';
            successEl.classList.remove('hidden');
            setTimeout(() => {
                window.location.href = `/posts/${data.slug || postSlug}`;
            }, 800);
        } else {
            errorEl.textContent = data.error || 'Something went wrong.';
            errorEl.classList.remove('hidden');
        }
    });
</script>
<script src="/js/script.js"></script>
</body>
</html>
