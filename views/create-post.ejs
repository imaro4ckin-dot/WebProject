<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Budget Escapes | <%= typeof post !== 'undefined' ? 'Edit Post' : 'New Post' %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Quill rich text editor -->
    <link href="https://cdn.quilljs.com/1.3.7/quill.snow.css" rel="stylesheet">
    <style>
        .ql-editor { min-height: 280px; font-size: 1rem; line-height: 1.75; }
        .ql-toolbar { border-radius: 6px 6px 0 0; border-color: #d1d5db; }
        .ql-container { border-radius: 0 0 6px 6px; border-color: #d1d5db; background: white; }
    </style>
</head>
<body class="bg-gray-100 text-gray-800 font-sans flex flex-col min-h-screen m-0">

<%- include('partials/header', { page: '' }) %>

<main role="main" class="flex-grow p-6 md:p-12 max-w-3xl mx-auto w-full">

    <h1 class="text-3xl font-bold text-blue-900 mb-8">
        <%= typeof post !== 'undefined' ? 'Edit Post' : 'Create a New Post' %>
    </h1>

    <form id="postForm" enctype="multipart/form-data" class="bg-white p-8 rounded shadow border border-gray-200 flex flex-col gap-6">

        <!-- Title -->
        <div class="flex flex-col">
            <label for="title" class="font-bold text-blue-900 mb-1">Title <span class="text-red-500">*</span></label>
            <input type="text" id="title" name="title" required
                value="<%= typeof post !== 'undefined' ? post.title : '' %>"
                placeholder="e.g. A Weekend in Lisbon on €50"
                class="p-3 border border-gray-300 rounded focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-200">
        </div>

        <!-- Category -->
        <div class="flex flex-col">
            <label for="category" class="font-bold text-blue-900 mb-1">Category <span class="text-red-500">*</span></label>
            <select id="category" name="category" required
                class="p-3 border border-gray-300 rounded focus:border-blue-500 focus:outline-none bg-white focus:ring-2 focus:ring-blue-200">
                <option value="" disabled <%= typeof post === 'undefined' ? 'selected' : '' %>>Select a category...</option>
                <% ['Nature','City','Culture','Food','Adventure'].forEach(function(cat) { %>
                    <option value="<%= cat %>" <%= typeof post !== 'undefined' && post.category === cat ? 'selected' : '' %>><%= cat %></option>
                <% }) %>
            </select>
        </div>

        <!-- Tags -->
        <div class="flex flex-col">
            <label for="tags" class="font-bold text-blue-900 mb-1">Tags <span class="text-gray-400 font-normal text-sm">(optional, comma-separated)</span></label>
            <input type="text" id="tags" name="tags"
                value="<%= typeof post !== 'undefined' && post.tags ? post.tags : '' %>"
                placeholder="e.g. budget, europe, hiking"
                class="p-3 border border-gray-300 rounded focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-200">
        </div>

        <!-- Featured Image -->
        <div class="flex flex-col">
            <label for="image" class="font-bold text-blue-900 mb-1">Featured Image <span class="text-gray-400 font-normal text-sm">(optional)</span></label>
            <% if (typeof post !== 'undefined' && post.image) { %>
                <div class="mb-3">
                    <img src="/Media/<%= post.image %>" alt="Current image" class="h-40 object-cover rounded border border-gray-200">
                    <p class="text-xs text-gray-500 mt-1">Upload a new image to replace this one.</p>
                </div>
            <% } %>
            <input type="file" id="image" name="image" accept="image/*"
                class="p-2 border border-gray-300 rounded text-sm text-gray-600 file:mr-4 file:py-2 file:px-4 file:rounded file:border-0 file:bg-blue-800 file:text-white file:font-bold hover:file:bg-blue-700 cursor-pointer">
        </div>

        <!-- Content — Quill editor -->
        <div class="flex flex-col">
            <label class="font-bold text-blue-900 mb-1">Content <span class="text-red-500">*</span></label>
            <div id="quillEditor"></div>
            <!-- Hidden textarea that holds the HTML for form submission -->
            <input type="hidden" id="content" name="content">
        </div>

        <p id="formError" class="text-red-600 text-sm hidden"></p>
        <p id="formSuccess" class="text-green-700 text-sm hidden"></p>

        <div class="flex gap-4">
            <button type="submit"
                class="bg-red-500 hover:bg-red-600 text-white font-bold py-3 px-8 rounded transition-colors">
                <%= typeof post !== 'undefined' ? 'Save Changes' : 'Publish Post' %>
            </button>
            <a href="/destinations" class="bg-gray-200 hover:bg-gray-300 text-gray-700 font-bold py-3 px-8 rounded transition-colors">
                Cancel
            </a>
        </div>

    </form>
</main>

<%- include('partials/footer') %>

<script src="https://cdn.quilljs.com/1.3.7/quill.min.js"></script>
<script>
    // --- Quill setup ---
    const quill = new Quill('#quillEditor', {
        theme: 'snow',
        placeholder: 'Write your travel post here...',
        modules: {
            toolbar: [
                [{ header: [2, 3, false] }],
                ['bold', 'italic', 'underline'],
                [{ list: 'ordered' }, { list: 'bullet' }],
                ['blockquote', 'link'],
                ['clean']
            ]
        }
    });

    // Pre-fill editor when editing an existing post
    <% if (typeof post !== 'undefined' && post.content) { %>
        quill.root.innerHTML = `<%- post.content.replace(/`/g, '\\`') %>`;
    <% } %>

    // --- Form submission ---
    const form       = document.getElementById('postForm');
    const errorEl    = document.getElementById('formError');
    const successEl  = document.getElementById('formSuccess');

    <% const isEdit = typeof post !== 'undefined'; %>
    const isEdit = <%= isEdit %>;
    const postId = isEdit ? <%= isEdit ? post.id : 'null' %> : null;

    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        errorEl.classList.add('hidden');
        successEl.classList.add('hidden');

        // Copy Quill HTML into the hidden input before submitting
        const html = quill.root.innerHTML;
        if (html === '<p><br></p>' || html.trim() === '') {
            errorEl.textContent = 'Content cannot be empty.';
            errorEl.classList.remove('hidden');
            return;
        }
        document.getElementById('content').value = html;

        const formData = new FormData(form);
        const url    = isEdit ? `/api/posts/${postId}` : '/api/posts';
        const method = isEdit ? 'PUT' : 'POST';

        const res  = await fetch(url, { method, body: formData });
        const data = await res.json();

        if (res.ok) {
            successEl.textContent = isEdit ? 'Post updated!' : 'Post published!';
            successEl.classList.remove('hidden');
            setTimeout(() => {
                window.location.href = isEdit ? `/posts/${postId}` : `/posts/${data.postId}`;
            }, 800);
        } else {
            errorEl.textContent = data.error || 'Something went wrong.';
            errorEl.classList.remove('hidden');
        }
    });
</script>
<script src="/js/script.js"></script>
</body>
</html>
