<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Budget Escapes | Contact</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Space+Grotesk:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body style="display:flex; flex-direction:column; min-height:100vh; margin:0;">

<%- include('partials/header', { page: 'contact' }) %>

<main id="main-content" role="main" style="flex-grow:1;" class="container section">
    <section class="text-center" style="margin-bottom: var(--space-6); position:relative; overflow:hidden;">
        <span class="icon-slot" style="top:0; left:12%; width:44px; height:44px; opacity:0.1;" aria-hidden="true"><svg viewBox="0 0 32 32"><use href="#icon-plane"></use></svg></span>
        <span class="icon-slot" style="top:6px; right:10%; width:40px; height:40px; opacity:0.1;" aria-hidden="true"><svg viewBox="0 0 32 32"><use href="#icon-balloon"></use></svg></span>
        <div class="eyebrow" style="text-align:center;">say hello</div>
        <h1>Get in touch</h1>
        <p>Have a hidden gem to recommend? Drop us a line!</p>
    </section>

    <section class="contact-panel">
        <div class="contact-info">
            <h2>Contact info</h2>
            <p><strong>Email:</strong> hello@budgetescapes.edu</p>
            <p><strong>Phone:</strong> +49 123 456 7890</p>
            <p><strong>Office:</strong> Somewhere in Germany</p>
        </div>

        <div>
            <form id="contactForm">
                <div class="field">
                    <label for="userName">Full name</label>
                    <input type="text" id="userName" name="userName" required aria-required="true" placeholder="Jane Doe">
                </div>
                <div class="field">
                    <label for="userEmail">Email address</label>
                    <input type="email" id="userEmail" name="userEmail" required aria-required="true" placeholder="jane@example.com">
                </div>
                <div class="field">
                    <label for="userMessage">Message</label>
                    <textarea id="userMessage" name="userMessage" rows="4" required aria-required="true" placeholder="Your message..."></textarea>
                </div>
                <button type="submit" class="btn">Send message</button>
            </form>

            <div id="successMessage" hidden aria-live="polite" class="alert alert-success" style="text-align:center; margin-top: var(--space-4);">
                <h3 style="margin-bottom:4px;">Thank you!</h3>
                <p style="margin:0; color: inherit;">Your message has been sent.</p>
            </div>
        </div>
    </section>
</main>

<%- include('partials/footer') %>
<script src="/js/script.js"></script>
</body>
</html>
