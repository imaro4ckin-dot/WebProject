<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Budget Escapes | Destinations</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Space+Grotesk:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body style="display:flex; flex-direction:column; min-height:100vh; margin:0;">

<%- include('partials/header', { page: 'destinations' }) %>

<main id="main-content" role="main" style="flex-grow:1;">
    <section class="page-intro">
        <span class="icon-slot" style="top:10px; left:30px; width:44px; height:44px; opacity:0.1;" aria-hidden="true"><svg viewBox="0 0 32 32"><use href="#icon-camera"></use></svg></span>
        <span class="icon-slot" style="top:10px; right:30px; width:44px; height:44px; opacity:0.1;" aria-hidden="true"><svg viewBox="0 0 32 32"><use href="#icon-backpack"></use></svg></span>
        <h1>Our travel blog</h1>
        <p>Filter by category or search to find your next adventure.</p>
    </section>

    <!-- Search bar -->
    <form method="GET" action="/destinations" class="container search-bar" style="margin-top: var(--space-5);">
        <input
            type="search"
            name="q"
            value="<%= q %>"
            placeholder="Search destinations..."
            aria-label="Search posts"
        >
        <button type="submit" class="btn">Search</button>
        <% if (q) { %>
            <a href="/destinations" class="btn-ghost" style="align-self:center; font-size:13px;">Clear</a>
        <% } %>
    </form>

    <!-- Category filter chips -->
    <section class="container filter-bar" style="justify-content:center;" aria-label="Destination filters">
        <% const cats = ['all','Nature','City','Culture','Food','Adventure']; %>
        <% cats.forEach(function(cat) { %>
            <a href="/destinations?category=<%= cat === 'all' ? '' : cat %><%= q ? '&q=' + encodeURIComponent(q) : '' %>"
               class="filter-chip <%= category === cat ? 'active' : '' %>"
               aria-pressed="<%= category === cat ? 'true' : 'false' %>">
                <%= cat === 'all' ? 'All trips' : cat %>
            </a>
        <% }) %>
    </section>

    <!-- Posts grid -->
    <section class="posts" style="position:relative; overflow:hidden;">
        <span class="icon-slot" style="top:0px; right:10px; width:60px; height:60px; opacity:0.08;" aria-hidden="true"><svg viewBox="0 0 32 32"><use href="#icon-summit"></use></svg></span>
        <span class="icon-slot" style="bottom:20px; left:0px; width:50px; height:50px; opacity:0.08;" aria-hidden="true"><svg viewBox="0 0 32 32"><use href="#icon-pool-ladder"></use></svg></span>

        <% if (posts.length === 0) { %>
            <p class="text-center" style="color: var(--text-muted); padding: var(--space-7) 0;">
                No posts found. Try a different search or category.
            </p>
        <% } else { %>
            <%
                const categoryIcon = (category) => {
                    const key = (category || '').toLowerCase();
                    if (key.includes('beach') || key.includes('island')) return 'coconut-tree';
                    if (key.includes('train') || key.includes('rail')) return 'train';
                    if (key.includes('hike') || key.includes('hiking') || key.includes('forest') || key.includes('nature')) return 'tree';
                    if (key.includes('mountain') || key.includes('summit') || key.includes('adventure')) return 'summit';
                    return 'plane';
                };
            %>
            <div class="grid">
                <% posts.forEach(function(post) { %>
                    <article class="card animate gallery-item" data-category="<%= post.category.toLowerCase() %>">
                        <% if (post.image) { %>
                            <div class="card-img">
                                <img src="/Media/<%= post.image %>" alt="<%= post.title %>"
                                     class="lightbox-trigger" style="cursor:pointer;"
                                     tabindex="0" role="button" aria-label="Enlarge image">
                            </div>
                        <% } else { %>
                            <div class="card-img"><span class="icon-slot" style="position:static; width:34px; height:34px; opacity:1; color:var(--accent);" aria-hidden="true"><svg viewBox="0 0 32 32"><use href="#icon-<%= categoryIcon(post.category) %>"></use></svg></span></div>
                        <% } %>
                        <div class="card-body">
                            <span class="tag">
                                <span class="icon-slot" style="position:static; width:11px; height:11px; opacity:1; vertical-align:-1px; margin-right:4px; color:var(--accent-2);" aria-hidden="true"><svg viewBox="0 0 32 32"><use href="#icon-<%= categoryIcon(post.category) %>"></use></svg></span><%= post.category %>
                            </span>
                            <h3><%= post.title %></h3>
                            <p class="byline">by <a href="/users/<%= post.user_id %>"><%= post.username %></a></p>
                            <a href="/posts/<%= post.slug %>" aria-label="Read full post: <%= post.title %>" class="read-more">Read full post →</a>
                        </div>
                    </article>
                <% }) %>
            </div>
        <% } %>
    </section>

    <section class="spotlight" aria-label="Featured destination">
        <span class="icon-slot" style="top:20px; left:20px; width:50px; height:50px; opacity:0.1;" aria-hidden="true"><svg viewBox="0 0 32 32"><use href="#icon-tree"></use></svg></span>
        <div class="spotlight-inner">
            <div>
                <div class="eyebrow">Spotlight</div>
                <h2>Heidelberg</h2>
                <p>Planning your next weekend escape? Heidelberg is our top-rated student destination this month. Nestled along the Neckar River, it offers a perfect mix of challenging nature hikes and cozy, budget-friendly city cafes.</p>
                <a href="/book" class="btn" aria-label="Book a trip to Heidelberg">Book this trip →</a>
            </div>
            <div class="spotlight-media">
                <iframe src="https://maps.google.com/maps?q=Heidelberg&t=&z=13&ie=UTF8&iwloc=&output=embed"
                        width="100%" height="350" style="border:0; display:block;" allowfullscreen="" loading="lazy"
                        title="Interactive map of Heidelberg, Germany"></iframe>
            </div>
        </div>
    </section>
</main>

<div id="lightbox" role="dialog" aria-modal="true" aria-label="Image gallery lightbox" class="lightbox hidden">
    <button class="close-lightbox" aria-label="Close lightbox">×</button>
    <img id="lightbox-img" src="" alt="Enlarged image">
</div>

<%- include('partials/footer') %>

<script src="/js/script.js"></script>
</body>
</html>
