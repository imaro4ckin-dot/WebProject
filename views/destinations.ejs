<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Budget Escapes | Destinations</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(20px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        .card { animation: fadeInUp 0.5s ease forwards; }
    </style>
</head>
<body class="bg-gray-100 text-gray-800 font-sans flex flex-col min-h-screen m-0">

<%- include('partials/header', { page: 'destinations' }) %>

<main role="main" class="flex-grow">
    <section class="text-center py-10 px-4">
        <h1 class="text-3xl font-bold text-blue-900 mb-2">Our Travel Blog</h1>
        <p class="text-gray-600">Filter by category or search to find your next adventure.</p>
    </section>

    <!-- Search bar -->
    <form method="GET" action="/destinations" class="flex justify-center mb-4 px-4 gap-2">
        <input
            type="text"
            name="q"
            value="<%= q %>"
            placeholder="Search destinations..."
            class="border border-gray-300 rounded-l px-4 py-2 w-full max-w-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
            aria-label="Search posts"
        >
        <button type="submit" class="bg-blue-800 text-white px-4 py-2 rounded-r font-bold hover:bg-blue-700 transition-colors">Search</button>
        <% if (q) { %>
            <a href="/destinations" class="ml-2 text-gray-500 hover:text-red-500 self-center text-sm">Clear</a>
        <% } %>
    </form>

    <!-- Category filter buttons -->
    <section class="flex justify-center gap-4 mb-8 px-4 flex-wrap" aria-label="Destination Filters">
        <% const cats = ['all','Nature','City','Culture','Food','Adventure']; %>
        <% cats.forEach(function(cat) { %>
            <a href="/destinations?category=<%= cat === 'all' ? '' : cat %><%= q ? '&q=' + encodeURIComponent(q) : '' %>"
               class="filter-btn px-6 py-2 rounded font-bold border-2 border-blue-800 transition-colors
                      <%= (category === cat || (cat === 'all' && category === 'all')) ? 'bg-blue-800 text-white' : 'bg-white text-blue-800 hover:bg-blue-100' %>"
               aria-pressed="<%= category === cat ? 'true' : 'false' %>">
                <%= cat === 'all' ? 'All Trips' : cat %>
            </a>
        <% }) %>
    </section>

    <!-- Posts grid -->
    <section class="px-6 pb-12 max-w-6xl mx-auto">
        <% if (posts.length === 0) { %>
            <p class="text-center text-gray-500 py-12">No posts found. Try a different search or category.</p>
        <% } else { %>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            <% posts.forEach(function(post) { %>
                <div class="card gallery-item bg-white rounded shadow border border-gray-200 overflow-hidden flex flex-col" data-category="<%= post.category.toLowerCase() %>">
                    <% if (post.image) { %>
                        <img src="/Media/<%= post.image %>" alt="<%= post.title %>"
                             class="lightbox-trigger w-full h-48 object-cover cursor-pointer hover:opacity-80 transition-opacity"
                             tabindex="0" role="button" aria-label="Enlarge image">
                    <% } else { %>
                        <div class="w-full h-48 bg-blue-100 flex items-center justify-center text-blue-300 text-5xl">✈</div>
                    <% } %>
                    <div class="p-4 flex flex-col flex-grow">
                        <span class="text-xs font-bold uppercase text-blue-500 bg-blue-50 px-2 py-1 rounded mb-2 self-start"><%= post.category %></span>
                        <h3 class="text-lg font-bold text-blue-900 mb-1 flex-grow"><%= post.title %></h3>
                        <p class="text-gray-500 text-sm mb-3">By <a href="/users/<%= post.user_id %>" class="hover:underline text-red-500"><%= post.username %></a></p>
                        <a href="/posts/<%= post.id %>" aria-label="Read full post: <%= post.title %>" class="text-red-500 font-bold hover:underline self-start">Read Full Post &rarr;</a>
                    </div>
                </div>
            <% }) %>
        </div>
        <% } %>
    </section>

    <section class="bg-blue-50 py-12 px-6 border-t border-blue-200" aria-label="Featured Destination">
        <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
            <div>
                <h2 class="text-3xl font-bold text-blue-900 mb-4">Spotlight: Heidelberg</h2>
                <p class="text-gray-700 mb-4 leading-relaxed">
                    Planning your next weekend escape? Heidelberg is our top-rated student destination this month!
                    Nestled along the Neckar River, it offers a perfect mix of challenging nature hikes and cozy, budget-friendly city cafes.
                </p>
                <a href="/book" class="inline-block bg-blue-800 hover:bg-blue-700 text-white font-bold py-2 px-6 rounded transition-colors focus:outline-none focus:ring-2 focus:ring-blue-500" aria-label="Book a trip to Heidelberg">
                    Book This Trip &rarr;
                </a>
            </div>
            <div class="rounded shadow-lg overflow-hidden border-4 border-white">
                <iframe src="https://maps.google.com/maps?q=Heidelberg&t=&z=13&ie=UTF8&iwloc=&output=embed"
                        width="100%" height="350" style="border:0;" allowfullscreen="" loading="lazy"
                        title="Interactive map of Heidelberg, Germany"></iframe>
            </div>
        </div>
    </section>
</main>

<div id="lightbox" role="dialog" aria-modal="true" aria-label="Image gallery lightbox" class="hidden fixed inset-0 bg-black bg-opacity-90 z-50 justify-center items-center">
    <button class="close-lightbox absolute top-4 right-6 text-white text-5xl font-bold cursor-pointer bg-transparent border-0" aria-label="Close lightbox">×</button>
    <img id="lightbox-img" class="max-w-[90%] max-h-[80%] rounded shadow-lg" src="" alt="Enlarged image">
</div>

<%- include('partials/footer') %>

<script src="/js/script.js"></script>
</body>
</html>
