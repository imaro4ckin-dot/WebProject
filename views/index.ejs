<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Budget Escapes | Home</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(20px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        .card { animation: fadeInUp 0.5s ease forwards; }
        .card:nth-child(2) { animation-delay: 0.2s; }
        .card:nth-child(3) { animation-delay: 0.4s; }
    </style>
</head>
<body class="bg-gray-100 text-gray-800 font-sans flex flex-col min-h-screen m-0">

<%- include('partials/header', { page: 'home' }) %>

<main role="main" class="flex-grow">
    <section class="bg-blue-100 text-center py-16 px-4 border-b border-gray-300">
        <h1 class="text-4xl font-bold text-blue-900 mb-4">Discover Local Hidden Gems</h1>
        <p class="text-lg text-gray-700 mb-8 max-w-2xl mx-auto">Affordable, unforgettable weekend escapes for students on a budget.</p>
        <a href="/destinations" class="inline-block bg-red-500 hover:bg-red-600 text-white font-bold py-3 px-6 rounded shadow transition-colors">
            Explore Trips
        </a>
    </section>

    <section class="p-8 max-w-5xl mx-auto">
        <h2 class="text-2xl font-bold text-center text-blue-900 mb-8">Recent Travel Posts</h2>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            <% if (posts.length === 0) { %>
                <p class="text-gray-500 col-span-3 text-center">No posts yet. Be the first to share a destination!</p>
            <% } %>
            <% posts.forEach(function(post, i) { %>
                <article class="card bg-white rounded shadow border border-gray-200 overflow-hidden transition-transform duration-300 hover:-translate-y-2 hover:shadow-lg" style="animation-delay: <%= i * 0.15 %>s">
                    <% if (post.image) { %>
                        <img src="/Media/<%= post.image %>" alt="<%= post.title %>" class="w-full h-48 object-cover">
                    <% } else { %>
                        <div class="w-full h-48 bg-blue-100 flex items-center justify-center text-blue-300 text-5xl">✈</div>
                    <% } %>
                    <div class="p-6">
                        <span class="text-xs font-bold uppercase text-blue-500 bg-blue-50 px-2 py-1 rounded mb-2 inline-block"><%= post.category %></span>
                        <h3 class="text-xl font-bold text-blue-800 mb-1"><%= post.title %></h3>
                        <p class="text-gray-500 text-sm mb-3">By <a href="/users/<%= post.user_id %>" class="hover:underline text-red-500"><%= post.username %></a></p>
                        <a href="/posts/<%= post.id %>" aria-label="Read full post: <%= post.title %>" class="text-red-500 font-bold hover:underline">Read Full Post &rarr;</a>
                    </div>
                </article>
            <% }) %>
        </div>
    </section>
</main>

<%- include('partials/footer') %>

<script src="/js/script.js"></script>
</body>
</html>
