<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Budget Escapes | Home</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Space+Grotesk:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(20px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        .card.animate { animation: fadeInUp 0.5s ease forwards; opacity: 0; }
    </style>
</head>
<body style="display:flex; flex-direction:column; min-height:100vh; margin:0;">

<%- include('partials/header', { page: 'home' }) %>

<main id="main-content" role="main" style="flex-grow:1;">
    <section class="hero">
        <span class="icon-slot" style="top:20px; left:40px; width:56px; height:56px; opacity:0.1;" aria-hidden="true"><svg viewBox="0 0 32 32"><use href="#icon-plane"></use></svg></span>
        <span class="icon-slot" style="top:24px; right:70px; width:50px; height:50px; opacity:0.1;" aria-hidden="true"><svg viewBox="0 0 32 32"><use href="#icon-balloon"></use></svg></span>
        <span class="icon-slot" style="bottom:14px; left:120px; width:40px; height:40px; opacity:0.1;" aria-hidden="true"><svg viewBox="0 0 32 32"><use href="#icon-backpack"></use></svg></span>
        <span class="icon-slot" style="bottom:24px; right:120px; width:42px; height:42px; opacity:0.1;" aria-hidden="true"><svg viewBox="0 0 32 32"><use href="#icon-camera"></use></svg></span>

        <div class="eyebrow">for students, by students</div>
        <h1>Discover<br><span class="hl">HIDDEN GEMS</span></h1>
        <p>Affordable, unforgettable weekend escapes for students on a budget.</p>
        <a href="/destinations" class="btn btn-lg">Explore trips →</a>
    </section>

    <section class="posts" style="position:relative; overflow:hidden;">
        <span class="icon-slot" style="top:0px; right:10px; width:60px; height:60px; opacity:0.08;" aria-hidden="true"><svg viewBox="0 0 32 32"><use href="#icon-summit"></use></svg></span>
        <span class="icon-slot" style="bottom:20px; left:0px; width:50px; height:50px; opacity:0.08;" aria-hidden="true"><svg viewBox="0 0 32 32"><use href="#icon-pool-ladder"></use></svg></span>

        <h2>Recent posts</h2>

        <div class="grid">
            <% if (posts.length === 0) { %>
                <p class="text-center" style="grid-column: 1 / -1; color: var(--text-muted);">
                    No posts yet. Be the first to share a destination!
                </p>
            <% } %>
            <%
                // Maps a post's category to one of the decorative pixel icons.
                // Falls back to a plane for anything unrecognized.
                const categoryIcon = (category) => {
                    const key = (category || '').toLowerCase();
                    if (key.includes('beach') || key.includes('island')) return 'coconut-tree';
                    if (key.includes('train') || key.includes('rail')) return 'train';
                    if (key.includes('hike') || key.includes('hiking') || key.includes('forest')) return 'tree';
                    if (key.includes('mountain') || key.includes('summit')) return 'summit';
                    return 'plane';
                };
            %>
            <% posts.forEach(function(post, i) { %>
                <article class="card animate" style="animation-delay: <%= i * 0.15 %>s">
                    <% if (post.image) { %>
                        <div class="card-img"><img src="/Media/<%= post.image %>" alt="<%= post.title %>"></div>
                    <% } else { %>
                        <div class="card-img"><span class="icon-slot" style="position:static; width:34px; height:34px; opacity:1; color:var(--accent);" aria-hidden="true"><svg viewBox="0 0 32 32"><use href="#icon-<%= categoryIcon(post.category) %>"></use></svg></span></div>
                    <% } %>
                    <div class="card-body">
                        <span class="tag">
                            <span class="icon-slot" style="position:static; width:11px; height:11px; opacity:1; vertical-align:-1px; margin-right:4px; color:var(--accent-2);" aria-hidden="true"><svg viewBox="0 0 32 32"><use href="#icon-<%= categoryIcon(post.category) %>"></use></svg></span><%= post.category %>
                        </span>
                        <h3><%= post.title %></h3>
                        <p class="byline">by <a href="/users/<%= post.user_id %>"><%= post.username %></a></p>
                        <a href="/posts/<%= post.slug %>" aria-label="Read full post: <%= post.title %>" class="read-more">Read full post →</a>
                    </div>
                </article>
            <% }) %>
        </div>
    </section>
</main>

<%- include('partials/footer') %>

<script src="/js/script.js"></script>
</body>
</html>
