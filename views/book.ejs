<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Budget Escapes | Book a Trip</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Space+Grotesk:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body style="display:flex; flex-direction:column; min-height:100vh; margin:0;">

<%- include('partials/header', { page: 'book' }) %>

<main role="main" style="flex-grow:1;">
    <section class="page-intro">
        <span class="icon-slot" style="top:10px; left:30px; width:44px; height:44px; opacity:0.1;"><svg viewBox="0 0 32 32"><use href="#icon-plane"></use></svg></span>
        <span class="icon-slot" style="top:10px; right:30px; width:44px; height:44px; opacity:0.1;"><svg viewBox="0 0 32 32"><use href="#icon-balloon"></use></svg></span>
        <h1>Book your escape</h1>
        <p>Reserve your spot on one of our upcoming group student trips.</p>
    </section>

    <div class="form-page wide">
        <section class="form-card">
            <form id="contactForm">
                <div class="field">
                    <label for="bookName">Full name</label>
                    <input type="text" id="bookName" name="bookName" required aria-required="true" placeholder="John Doe">
                </div>
                <div class="field">
                    <label for="studentId">Student ID</label>
                    <input type="text" id="studentId" name="studentId" required aria-required="true" placeholder="123456">
                </div>
                <div class="field">
                    <label for="destination">Choose destination</label>
                    <select id="destination" name="destination" required aria-required="true">
                        <option value="" disabled selected>Select a trip...</option>
                        <option value="heidelberg">Heidelberg Hike (€20)</option>
                        <option value="coffee-tour">Coffee Tour (€15)</option>
                    </select>
                </div>
                <div class="field">
                    <label for="travelDate">Select date</label>
                    <input type="date" id="travelDate" name="travelDate" required aria-required="true">
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-lg" style="width:100%;">Confirm booking request</button>
                </div>
            </form>

            <div id="successMessage" hidden aria-live="polite" class="alert alert-success text-center" style="margin-top: var(--space-5);">
                <h3 style="margin-bottom:6px; color:var(--success);">Booking received!</h3>
                <p style="color:var(--success); margin:0;">Check your student email for the payment link.</p>
            </div>
        </section>
    </div>
</main>

<%- include('partials/footer') %>
<script src="/js/script.js"></script>
</body>
</html>
