<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Budget Escapes | <%= profileUser.username %>'s Profile</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Space+Grotesk:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body style="display:flex; flex-direction:column; min-height:100vh; margin:0;">

<%- include('partials/header', { page: '' }) %>

<main id="main-content" role="main" class="container" style="padding-top: var(--space-6); padding-bottom: var(--space-8);">

    <section class="profile-header" style="border:1px solid var(--border); border-radius:var(--radius-lg); padding: var(--space-6); background: var(--surface);">
        <span class="avatar" style="width:128px; height:128px; border:4px solid var(--accent-soft);">
            <img src="/Media/<%= profileUser.profile_pic || 'default.jpg' %>" alt="Profile picture of <%= profileUser.username %>">
        </span>

        <div class="profile-meta" style="flex:1;">
            <h1><%= profileUser.username %></h1>
            <p class="handle">Member since <%= new Date(profileUser.created_at).toLocaleDateString('en-GB', { month: 'long', year: 'numeric' }) %></p>
            <p><%= profileUser.bio || 'No bio yet.' %></p>

            <% if (user && user.id === profileUser.id) { %>
                <button id="editProfileBtn" class="btn btn-sm" type="button" style="margin-top:6px;">Edit profile</button>
            <% } %>
        </div>
    </section>

    <% if (user && user.id === profileUser.id) { %>
    <section id="editProfileForm" class="form-card hidden" style="margin-top: var(--space-5);">
        <h2 style="font-size:20px;">Edit your profile</h2>
        <form id="profileForm" enctype="multipart/form-data">
            <div class="field">
                <label for="bio">Bio</label>
                <textarea id="bio" name="bio" rows="3" placeholder="Tell the community about yourself..."><%= profileUser.bio || '' %></textarea>
            </div>
            <div class="field">
                <label for="profile_pic">Profile picture</label>
                <input type="file" id="profile_pic" name="profile_pic" accept="image/*">
            </div>
            <div class="form-actions">
                <button type="submit" class="btn">Save changes</button>
                <button type="button" id="cancelEditBtn" class="btn btn-outline">Cancel</button>
            </div>
            <p id="profileMsg" class="text-success hidden" style="font-weight:700; margin-top:12px;" role="status"></p>
        </form>
    </section>
    <% } %>

  <section class="passport-section" style="margin-top: var(--space-7);">
        <h2 style="font-size:22px; margin-bottom: var(--space-4);">Digital Passport</h2>

        <div class="passport-booklet grid-3">
            <% if (typeof passportStamps !== 'undefined' && passportStamps.length > 0) { %>
                <% passportStamps.forEach(function(stamp, index) { %>
                    <%
                        // Alternate rotations so they look stamped by hand
                        const rotation = stamp.is_unlocked ? (index % 2 === 0 ? '-6deg' : '4deg') : '0deg';
                    %>
                    <div class="stamp-wrapper">
                        <div class="stamp-container <%= stamp.is_unlocked ? 'stamp-unlocked' : 'stamp-locked' %>" style="transform: rotate(<%= rotation %>);">

                            <span class="icon-slot" style="position:static; width:44px; height:44px; display:inline-block; margin-top: 8px;">
                                <svg viewBox="0 0 32 32"><use href="#icon-<%= stamp.is_unlocked ? stamp.icon_id : 'lock' %>"></use></svg>
                            </span>

                            <% if (stamp.is_unlocked) { %>
                                <h3><%= stamp.country %></h3>
                                <p><%= new Date(stamp.earned_at).toLocaleDateString('en-GB') %></p>
                            <% } else { %>
                                <h3>LOCKED</h3>
                            <% } %>

                        </div>

                        <% if (stamp.is_unlocked) { %>
                            <p style="font-size: 13px; margin-top: 16px; font-weight: 600; color: var(--text);">
                                <%= stamp.name %>
                            </p>
                        <% } else { %>
                            <p style="font-size: 13px; margin-top: 16px; color: var(--text-muted);">
                                Keep traveling
                            </p>
                        <% } %>
                    </div>
                <% }) %>
            <% } else { %>
                <p style="color: var(--text-muted); grid-column: 1 / -1; text-align: center;">No stamps available in the database yet.</p>
            <% } %>
        </div>
    </section>

    <section style="margin-top: var(--space-7);">
        <h2 style="font-size:22px; margin-bottom: var(--space-5);">Posts by <%= profileUser.username %> (<%= posts.length %>)</h2>

        <% if (posts.length === 0) { %>
            <p style="color: var(--text-muted);">No posts published yet.</p>
        <% } else { %>
            <%
                const categoryIcon = (category) => {
                    const key = (category || '').toLowerCase();
                    if (key.includes('beach') || key.includes('island')) return 'coconut-tree';
                    if (key.includes('train') || key.includes('rail')) return 'train';
                    if (key.includes('hike') || key.includes('hiking') || key.includes('forest') || key.includes('nature')) return 'tree';
                    if (key.includes('mountain') || key.includes('summit') || key.includes('adventure')) return 'summit';
                    return 'plane';
                };
            %>
            <div class="grid-3">
                <% posts.forEach(function(post) { %>
                    <article class="card">
                        <% if (post.image) { %>
                            <div class="card-img" style="height:130px;"><img src="/Media/<%= post.image %>" alt="<%= post.title %>"></div>
                        <% } else { %>
                            <div class="card-img" style="height:130px;"><span class="icon-slot" style="position:static; width:28px; height:28px; opacity:1; color:var(--accent);" aria-hidden="true"><svg viewBox="0 0 32 32"><use href="#icon-<%= categoryIcon(post.category) %>"></use></svg></span></div>
                        <% } %>
                        <div class="card-body">
                            <span class="tag"><%= post.category %></span>
                            <h3 style="font-size:16px;"><%= post.title %></h3>
                            <div style="display:flex; align-items:center; gap:12px; margin-top:8px;">
                                <a href="/posts/<%= post.slug %>" class="read-more" style="font-size:13px;">Read →</a>
                                <% if (user && user.id === profileUser.id) { %>
                                    <button onclick="deletePost(<%= post.id %>)" class="btn-ghost" style="margin-left:auto; font-size:13px; color:var(--text-muted);" type="button">Delete</button>
                                <% } %>
                            </div>
                        </div>
                    </article>
                <% }) %>
            </div>
        <% } %>
    </section>

</main>

<%- include('partials/footer') %>

<script>
    // Toggle edit form
    const editBtn = document.getElementById('editProfileBtn');
    const editForm = document.getElementById('editProfileForm');
    const cancelBtn = document.getElementById('cancelEditBtn');

    if (editBtn) editBtn.addEventListener('click', () => editForm.classList.toggle('hidden'));
    if (cancelBtn) cancelBtn.addEventListener('click', () => editForm.classList.add('hidden'));

    // Submit profile update
    const profileForm = document.getElementById('profileForm');
    if (profileForm) {
        profileForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData(profileForm);
            const res = await fetch('/api/users/<%= profileUser.id %>', {
                method: 'PUT',
                body: formData
            });
            const data = await res.json();
            const msg = document.getElementById('profileMsg');
            if (res.ok) {
                msg.textContent = 'Profile updated! Refresh to see changes.';
                msg.classList.remove('hidden', 'text-danger');
                msg.classList.add('text-success');
            } else {
                msg.textContent = data.error || 'Update failed.';
                msg.classList.remove('hidden', 'text-success');
                msg.classList.add('text-danger');
            }
        });
    }

    // Delete post
    async function deletePost(postId) {
        if (!confirm('Delete this post permanently?')) return;
        const res = await fetch(`/api/posts/${postId}`, { method: 'DELETE' });
        if (res.ok) window.location.reload();
        else alert('Failed to delete post.');
    }
</script>
<script src="/js/script.js"></script>
</body>
</html>