<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Budget Escapes | About Us</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Space+Grotesk:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        @keyframes fadeInUp { from { opacity:0; transform:translateY(20px); } to { opacity:1; transform:translateY(0); } }
        .team-card.animate { animation: fadeInUp 0.5s ease forwards; opacity: 0; }
        .team-card.animate:nth-child(2) { animation-delay: 0.2s; }
        .team-card.animate:nth-child(3) { animation-delay: 0.4s; }
    </style>
</head>
<body style="display:flex; flex-direction:column; min-height:100vh; margin:0;">

<%- include('partials/header', { page: 'about' }) %>

<main id="main-content" role="main" style="flex-grow:1;" class="container section">
    <section class="text-center" style="margin-bottom: var(--space-7); position:relative; overflow:hidden;">
        <span class="icon-slot" style="top:0; left:10%; width:48px; height:48px; opacity:0.1;" aria-hidden="true"><svg viewBox="0 0 32 32"><use href="#icon-backpack"></use></svg></span>
        <span class="icon-slot" style="top:10px; right:12%; width:44px; height:44px; opacity:0.1;" aria-hidden="true"><svg viewBox="0 0 32 32"><use href="#icon-camera"></use></svg></span>
        <div class="eyebrow" style="text-align:center;">the team</div>
        <h1>About our team</h1>
        <p style="max-width:480px; margin:0 auto;">We are a group of university students passionate about exploring the world without emptying our wallets.</p>
    </section>

    <section class="grid-3">
        <div class="team-card animate">
            <div class="team-avatar">
                <img src="/Media/WhatsApp Image 2026-03-13 at 09.16.51.jpeg" alt="Portrait of Mariana Naumenko, Lead Designer">
            </div>
            <h3>Mariana Naumenko</h3>
            <p class="role">Lead Designer</p>
            <p class="bio">Loves finding the best aesthetic cafes and hidden city art.</p>
        </div>

        <div class="team-card animate">
            <div class="team-avatar">
                <img src="/Media/IMG_1156.JPG" alt="Portrait of Ivan Marochkin, Lead Developer">
            </div>
            <h3>Ivan Marochkin</h3>
            <p class="role">Lead Developer</p>
            <p class="bio">Nature enthusiast always looking for the toughest hiking trails.</p>
        </div>

        <div class="team-card animate">
            <div class="team-avatar">
                <img src="/Media/IMG_3396.jpg" alt="Portrait of Rodrigo, Content Manager">
            </div>
            <h3>Rodrigo Chavez</h3>
            <p class="role">Content Manager</p>
            <p class="bio">The ultimate budget planner. Finds the cheapest bus tickets.</p>
        </div>
    </section>
</main>

<%- include('partials/footer') %>
<script src="/js/script.js"></script>
</body>
</html>
