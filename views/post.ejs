<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Budget Escapes | <%= post.title %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Space+Grotesk:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body style="display:flex; flex-direction:column; min-height:100vh; margin:0;">

<%- include('partials/header', { page: 'destinations' }) %>

<main id="main-content" role="main" class="article">

    <nav aria-label="Breadcrumb" class="breadcrumb">
        <ol>
            <li><a href="/">Home</a></li>
            <li><a href="/destinations">Destinations</a></li>
            <li aria-current="page"><%= post.title %></li>
        </ol>
    </nav>

    <%
        // Same category → icon mapping used on the destinations grid, kept here
        // so the article header can carry a faint watermark icon too.
        const categoryIcon = (category) => {
            const key = (category || '').toLowerCase();
            if (key.includes('beach') || key.includes('island')) return 'coconut-tree';
            if (key.includes('train') || key.includes('rail')) return 'train';
            if (key.includes('hike') || key.includes('hiking') || key.includes('forest') || key.includes('nature')) return 'tree';
            if (key.includes('mountain') || key.includes('summit') || key.includes('adventure')) return 'summit';
            return 'plane';
        };
    %>

    <article class="article-panel">
        <span class="icon-slot" style="top:-10px; right:-10px; width:130px; height:130px; opacity:0.06;" aria-hidden="true"><svg viewBox="0 0 32 32"><use href="#icon-<%= categoryIcon(post.category) %>"></use></svg></span>

        <header style="margin-bottom: var(--space-6); border-bottom: 1px solid var(--border); padding-bottom: var(--space-5);">
            <h1 style="font-size:32px; margin-bottom:14px;"><%= post.title %></h1>
            <div class="article-meta">
                <span class="by">By <a href="/users/<%= post.user_id %>"><%= post.username %></a></span>
                <span class="sep">|</span>
                <span>Published <%= new Date(post.created_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) %></span>
                <span class="sep">|</span>
                <span class="tag" style="margin-bottom:0;"><%= post.category %></span>
                <% if (post.views !== undefined) { %>
                    <span>👁 <%= post.views %> views</span>
                <% } %>
            </div>
            <% if (user && user.id === post.user_id) { %>
                <div class="article-owner-actions">
                    <a href="/posts/<%= post.slug %>/edit" class="btn btn-outline btn-sm">Edit</a>
                    <button id="deletePostBtn" class="btn btn-danger btn-sm" type="button">Delete</button>
                </div>
            <% } %>
        </header>

        <% if (post.image) { %>
            <div class="article-cover"><img src="<%= imgUrl(post.image) %>" alt="<%= post.title %>"></div>
        <% } %>

        <div class="article-body">
            <%- post.content %>
        </div>

        <% if (post.tags) { %>
            <div class="article-tags" style="margin-top: var(--space-5); display:flex; flex-wrap:wrap; gap:var(--space-2);">
                <% post.tags.split(',').map(t => t.trim()).filter(Boolean).forEach(function(tag) { %>
                    <span class="tag" style="font-size:12px;">#<%= tag %></span>
                <% }) %>
            </div>
        <% } %>

        <!-- Like & bookmark bar -->
        <div class="interaction-bar" style="flex-wrap:wrap;">
            <% if (user) { %>
                <button id="likeBtn" class="pill-btn <%= liked ? 'like-active' : '' %>" type="button"
                        aria-pressed="<%= liked ? 'true' : 'false' %>"
                        aria-label="<%= liked ? 'Unlike this post' : 'Like this post' %>">
                    ❤ <span id="likeLabel"><%= liked ? 'Liked' : 'Like' %></span>
                    <span id="likeCount" class="pill-count">(<%= likeCount %>)</span>
                </button>
                <button id="bookmarkBtn" class="pill-btn <%= bookmarked ? 'bookmark-active' : '' %>" type="button"
                        aria-pressed="<%= bookmarked ? 'true' : 'false' %>"
                        aria-label="<%= bookmarked ? 'Remove bookmark' : 'Bookmark this post' %>">
                    🔖 <span id="bookmarkLabel"><%= bookmarked ? 'Saved' : 'Save' %></span>
                </button>
            <% } else { %>
                <p style="color:var(--text-muted); font-size:13px; margin:0;">
                    <a href="/login" style="color:var(--accent); font-weight:700; text-decoration:none;">Log in</a> to like or save this post.
                </p>
            <% } %>

            <div class="share-links">
                <a href="https://twitter.com/intent/tweet?text=<%= encodeURIComponent(post.title) %>&url=<%= encodeURIComponent(baseUrl + '/posts/' + post.slug) %>"
                   target="_blank" rel="noopener" class="btn btn-outline btn-sm" aria-label="Share on Twitter">𝕏 Twitter</a>
                <a href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(baseUrl + '/posts/' + post.slug) %>"
                   target="_blank" rel="noopener" class="btn btn-outline btn-sm" aria-label="Share on Facebook">Facebook</a>
            </div>
        </div>
    </article>

    <!-- Comments section -->
    <section class="article-panel">
        <h3 id="commentsHeading" style="font-size:20px; margin-bottom: var(--space-5);">Comments (<%= comments.length %>)</h3>

        <div id="commentList" style="margin-bottom: var(--space-6);">
            <% if (comments.length === 0) { %>
                <p id="noComments" style="color:var(--text-muted); font-style:italic;">No comments yet. Share your thoughts!</p>
            <% } %>
            <% comments.forEach(function(c) { %>
                <div class="comment" data-comment-id="<%= c.id %>">
                    <div class="avatar"><%= c.username.charAt(0).toUpperCase() %></div>
                    <div class="comment-body">
                        <strong><a href="/users/<%= c.user_id %>" style="text-decoration:none; color:var(--text);"><%= c.username %></a></strong>
                        <span class="meta"><%= new Date(c.created_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
                        <% if (user && user.id === c.user_id) { %>
                            <button class="delete-comment-btn btn btn-danger btn-sm" style="float:right; margin-top:-2px;" data-comment-id="<%= c.id %>">Delete</button>
                        <% } %>
                        <p><%= c.body %></p>
                    </div>
                </div>
            <% }) %>
        </div>

        <% if (user) { %>
            <form id="commentForm" style="border-top: 1px solid var(--border); padding-top: var(--space-5);">
                <div class="field">
                    <label for="userComment">Leave a comment</label>
                    <textarea id="userComment" name="userComment" rows="3" placeholder="Write a comment..." required aria-required="true"></textarea>
                </div>
                <button type="submit" class="btn">Post comment</button>
            </form>
        <% } else { %>
            <p style="color:var(--text-muted); border-top: 1px solid var(--border); padding-top: var(--space-5);">
                <a href="/login" style="color:var(--accent); font-weight:700; text-decoration:none;">Log in</a> to leave a comment.
            </p>
        <% } %>
    </section>

</main>

<%- include('partials/footer') %>

<script>
    const POST_ID = <%= post.id %>;
    const CURRENT_USER_ID = <%= user ? user.id : 'null' %>;
    const CURRENT_USERNAME = '<%= user ? user.username.replace(/'/g, "\\'") : '' %>';

    const deleteBtn = document.getElementById('deletePostBtn');
    if (deleteBtn) {
        deleteBtn.addEventListener('click', async () => {
            if (!confirm('Delete this post permanently?')) return;
            const res = await fetch(`/api/posts/${POST_ID}`, { method: 'DELETE' });
            if (res.ok) window.location.href = '/destinations';
            else alert('Failed to delete post.');
        });
    }
</script>
<script src="/js/comments.js"></script>
<script src="/js/post-actions.js"></script>
<script src="/js/script.js"></script>
</body>
</html>
