<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Budget Escapes | <%= post.title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 text-gray-800 font-sans flex flex-col min-h-screen m-0">

<%- include('partials/header', { page: 'destinations' }) %>

<main role="main" class="flex-grow p-6 md:p-12 max-w-4xl mx-auto w-full">

    <a href="/destinations" aria-label="Go back to destinations" class="text-blue-800 hover:text-red-500 transition-colors mb-6 inline-block font-bold">
        &larr; Back to Destinations
    </a>

    <article class="bg-white p-6 md:p-10 rounded shadow border border-gray-200">

        <header class="mb-8 border-b border-gray-200 pb-6">
            <h1 class="text-4xl font-bold text-blue-900 mb-4"><%= post.title %></h1>
            <div class="flex flex-wrap gap-4 text-gray-600 text-sm">
                <span class="font-bold text-red-500">
                    By <a href="/users/<%= post.user_id %>" class="hover:underline"><%= post.username %></a>
                </span>
                <span>|</span>
                <span>Published: <%= new Date(post.created_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) %></span>
                <span>|</span>
                <span class="bg-blue-100 text-blue-800 px-2 py-1 rounded font-bold"><%= post.category %></span>
                <% if (post.views !== undefined) { %>
                    <span class="text-gray-400">👁 <%= post.views %> views</span>
                <% } %>
            </div>
            <% if (user && user.id === post.user_id) { %>
                <div class="flex gap-3 mt-3">
                    <a href="/posts/<%= post.id %>/edit" class="text-sm bg-blue-100 hover:bg-blue-200 text-blue-800 font-bold py-1 px-4 rounded transition-colors">Edit</a>
                    <button id="deletePostBtn" class="text-sm bg-red-100 hover:bg-red-200 text-red-700 font-bold py-1 px-4 rounded transition-colors">Delete</button>
                </div>
            <% } %>
        </header>

        <% if (post.image) { %>
            <img src="/Media/<%= post.image %>" alt="<%= post.title %>" class="w-full h-96 md:h-[36rem] object-cover object-center rounded mb-8 shadow-sm">
        <% } %>

        <div class="text-gray-700 leading-relaxed space-y-6 text-lg">
            <%- post.content %>
        </div>

        <!-- Like & Bookmark bar -->
        <div class="flex items-center gap-4 mt-10 pt-6 border-t border-gray-200">
            <% if (user) { %>
                <button id="likeBtn"
                    class="flex items-center gap-2 font-bold py-2 px-5 rounded-full transition-colors
                           <%= liked ? 'bg-blue-600 text-white' : 'bg-blue-100 hover:bg-blue-200 text-blue-800' %>">
                    ❤ <span id="likeLabel"><%= liked ? 'Liked' : 'Like' %></span>
                    <span id="likeCount" class="text-sm font-normal">(<%= likeCount %>)</span>
                </button>
                <button id="bookmarkBtn"
                    class="flex items-center gap-2 font-bold py-2 px-5 rounded-full transition-colors
                           <%= bookmarked ? 'bg-yellow-400 text-white' : 'bg-yellow-100 hover:bg-yellow-200 text-yellow-800' %>">
                    🔖 <span id="bookmarkLabel"><%= bookmarked ? 'Saved' : 'Save' %></span>
                </button>
            <% } else { %>
                <p class="text-gray-500 text-sm">
                    <a href="/login" class="text-blue-600 hover:underline font-bold">Log in</a> to like or save this post.
                </p>
            <% } %>

            <!-- Social sharing (Req 7.2) -->
            <div class="ml-auto flex gap-3">
                <a href="https://twitter.com/intent/tweet?text=<%= encodeURIComponent(post.title) %>&url=<%= encodeURIComponent(baseUrl + '/posts/' + post.id) %>"
                   target="_blank" rel="noopener"
                   class="bg-sky-500 hover:bg-sky-600 text-white font-bold py-2 px-4 rounded transition-colors text-sm"
                   aria-label="Share on Twitter">
                    𝕏 Twitter
                </a>
                <a href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(baseUrl + '/posts/' + post.id) %>"
                   target="_blank" rel="noopener"
                   class="bg-blue-700 hover:bg-blue-800 text-white font-bold py-2 px-4 rounded transition-colors text-sm"
                   aria-label="Share on Facebook">
                    Facebook
                </a>
            </div>
        </div>

    </article>

    <!-- Comments section -->
    <section class="mt-8 bg-white p-6 md:p-10 rounded shadow border border-gray-200">
        <h3 class="text-2xl font-bold text-blue-900 mb-6">Comments (<%= comments.length %>)</h3>

        <div id="commentList" class="space-y-6 mb-8">
            <% if (comments.length === 0) { %>
                <p id="noComments" class="text-gray-500 italic">No comments yet. Share your thoughts!</p>
            <% } %>
            <% comments.forEach(function(c) { %>
                <div class="flex gap-4 border-b border-gray-100 pb-4">
                    <div class="w-10 h-10 bg-blue-600 rounded-full flex items-center justify-center font-bold text-white text-sm shrink-0">
                        <%= c.username.charAt(0).toUpperCase() %>
                    </div>
                    <div class="flex-1">
                        <p class="font-bold text-gray-900">
                            <a href="/users/<%= c.user_id %>" class="hover:underline"><%= c.username %></a>
                            <span class="text-xs font-normal text-gray-500 ml-2">
                                <%= new Date(c.created_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                            </span>
                        </p>
                        <p class="text-gray-600"><%= c.body %></p>
                    </div>
                </div>
            <% }) %>
        </div>

        <% if (user) { %>
            <form id="commentForm" class="border-t border-gray-100 pt-6">
                <div class="mb-4">
                    <textarea id="userComment" rows="3" placeholder="Write a comment..." required
                        class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none block"></textarea>
                </div>
                <button type="submit" class="bg-blue-800 hover:bg-red-500 text-white font-bold py-2 px-6 rounded transition-all">
                    Post Comment
                </button>
            </form>
        <% } else { %>
            <p class="text-gray-500 border-t border-gray-100 pt-6">
                <a href="/login" class="text-blue-600 hover:underline font-bold">Log in</a> to leave a comment.
            </p>
        <% } %>
    </section>

</main>

<%- include('partials/footer') %>

<script>
    const POST_ID = <%= post.id %>;

    const deleteBtn = document.getElementById('deletePostBtn');
    if (deleteBtn) {
        deleteBtn.addEventListener('click', async () => {
            if (!confirm('Delete this post permanently?')) return;
            const res = await fetch(`/api/posts/${POST_ID}`, { method: 'DELETE' });
            if (res.ok) window.location.href = '/destinations';
            else alert('Failed to delete post.');
        });
    }
</script>
<script src="/js/comments.js"></script>
<script src="/js/post-actions.js"></script>
<script src="/js/script.js"></script>
</body>
</html>
