<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Budget Escapes | Page Not Found</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Space+Grotesk:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body style="display:flex; flex-direction:column; min-height:100vh; margin:0;">

<%- include('partials/header', { page: '' }) %>

<main id="main-content" role="main" style="flex-grow:1; display:flex; align-items:center; justify-content:center; position:relative; overflow:hidden;">
    <svg class="doodle-faint" style="top:10%; left:8%; width:70px; height:70px;" viewBox="0 0 70 70" aria-hidden="true">
        <path d="M8 50 Q25 15 60 22 Q80 26 70 8" stroke-linecap="round"/>
        <path d="M70 8 L63 6 M70 8 L67 16" stroke-linecap="round"/>
    </svg>
    <svg class="doodle-faint" style="bottom:14%; right:10%; width:56px; height:56px;" viewBox="0 0 56 56" aria-hidden="true">
        <rect x="14" y="6" width="18" height="30" rx="2"/>
        <line x1="14" y1="14" x2="32" y2="14"/>
        <path d="M20 6 V3 H26 V6"/>
    </svg>

    <div class="empty-state" style="position:relative; z-index:1; max-width:480px;">
        <div class="compass-wrap" id="compass" role="button" tabindex="0" aria-label="A curious compass. Try clicking it.">
            <svg viewBox="0 0 110 110">
                <circle cx="55" cy="55" r="48" fill="none" stroke="var(--text)" stroke-width="2.5"/>
                <circle cx="55" cy="55" r="3" fill="var(--text)"/>
                <text x="55" y="16" text-anchor="middle" font-family="Space Mono, monospace" font-size="9" fill="var(--text-muted)">N</text>
                <text x="55" y="102" text-anchor="middle" font-family="Space Mono, monospace" font-size="9" fill="var(--text-muted)">S</text>
                <g id="needle">
                    <path d="M55 55 L55 20 L48 40 Z" fill="var(--accent)"/>
                    <path d="M55 55 L55 90 L62 70 Z" fill="var(--text-muted)"/>
                </g>
            </svg>
        </div>

        <div class="eyebrow" style="text-align:center;">lost in transit</div>
        <h1 class="code">404</h1>
        <p>This page took a wrong turn somewhere between the hostel and the train station. Let's get you back on route.</p>
        <a href="/" class="btn btn-lg">Go home →</a>
        <div class="hint">psst — the compass looks a little unsure. try clicking it.</div>
        <div class="egg" id="egg"></div>
    </div>
</main>

<%- include('partials/footer') %>

<script>
    const compass = document.getElementById('compass');
    const needle  = document.getElementById('needle');
    const egg     = document.getElementById('egg');
    const messages = [
        "the needle just points to the nearest coffee. useful, honestly.",
        "recalculating... still lost.",
        "somewhere, a real compass is judging this one.",
        "okay fine — all roads lead to the homepage. go on.",
    ];
    let clicks = 0;
    function spin() {
        clicks++;
        const angle = 360 * (2 + Math.random() * 2) * (Math.random() > 0.5 ? 1 : -1);
        needle.style.transform = `rotate(${angle}deg)`;
        egg.textContent = messages[Math.min(clicks - 1, messages.length - 1)];
        egg.classList.add('show');
    }
    compass.addEventListener('click', spin);
    compass.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); spin(); } });
</script>
</body>
</html>
