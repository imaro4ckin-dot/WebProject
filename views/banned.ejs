<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Budget Escapes | Account Suspended</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Space+Grotesk:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body style="display:flex; flex-direction:column; min-height:100vh; margin:0;">

<%- include('partials/header', { page: '' }) %>

<main id="main-content" role="main" style="flex-grow:1; display:flex; align-items:center; justify-content:center; position:relative; overflow:hidden;">

    <!-- faint doodle decorations matching the 404 page style -->
    <svg class="doodle-faint" style="top:12%; left:6%; width:64px; height:64px;" viewBox="0 0 64 64" aria-hidden="true">
        <rect x="10" y="10" width="44" height="44" rx="4"/>
        <line x1="10" y1="28" x2="54" y2="28"/>
        <line x1="32" y1="10" x2="32" y2="54"/>
    </svg>
    <svg class="doodle-faint" style="bottom:12%; right:8%; width:54px; height:54px;" viewBox="0 0 54 54" aria-hidden="true">
        <circle cx="27" cy="27" r="22" fill="none" stroke-width="2"/>
        <line x1="17" y1="17" x2="37" y2="37"/>
        <line x1="37" y1="17" x2="17" y2="37"/>
    </svg>

    <div class="empty-state" style="position:relative; z-index:1; max-width:480px;">

        <!-- padlock icon built from SVG rects — pixel style to match the design -->
        <div style="width:72px; height:72px; margin: 0 auto var(--space-5);">
            <svg viewBox="0 0 24 24" fill="none" stroke="var(--danger)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="11" width="18" height="11" rx="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                <circle cx="12" cy="16" r="1" fill="var(--danger)"/>
            </svg>
        </div>

        <div class="eyebrow" style="text-align:center; color:var(--danger);">Account suspended</div>
        <h1 style="font-size:22px; text-align:center; margin-bottom: var(--space-3);">You've been banned</h1>
        <p style="text-align:center; max-width:340px; margin: 0 auto var(--space-5);">
            Your account has been suspended by an administrator and you can no longer access Budget Escapes.
            If you believe this is a mistake, please contact us.
        </p>

        <div style="display:flex; gap:12px; justify-content:center; flex-wrap:wrap;">
            <a href="/contact" class="btn btn-outline">Contact us</a>
            <a href="/" class="btn">Go to homepage</a>
        </div>
    </div>
</main>

<%- include('partials/footer') %>
</body>
</html>
